PUBLIC_URL=https://meet.example.org
HTTP_PORT=80
HTTPS_PORT=443
TZ=UTC
RESTART_POLICY=unless-stopped

ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=1

JVB_PORT=10000
JVB_ADVERTISE_IPS=203.0.113.10

ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=example-app
JWT_ENABLE_DOMAIN_VERIFICATION=true
JWT_ALLOW_EMPTY=0
ENABLE_AUTO_OWNER=false

ENABLE_P2P=0
ENABLE_WELCOME_PAGE=0
ENABLE_PREJOIN_PAGE=1
ENABLE_LOBBY=1
ENABLE_BREAKOUT_ROOMS=1
ENABLE_AV_MODERATION=1
DISABLE_DEEP_LINKING=1
DYNAMIC_BRANDING_URL=/static/brand/branding.json

XMPP_MODULES=muc_size,persistent_lobby
XMPP_MUC_MODULES=token_affiliation,token_lobby_bypass,token_lobby_autostart

MEET_FEATURES=
MEET_PLUGINS=events,control,single-session,privacy

MEET_APP_API_URL=https://app.example.org/meet/api
MEET_APP_KEYS_URL=https://app.example.org/meet/keys
MEET_APP_CONTROL_KEYS_URL=https://app.example.org/meet/control-keys

# Opt-in live captions: add transcription to MEET_FEATURES and configure a private endpoint.
JIGASI_TRANSCRIBER_WHISPER_URL=
JIGASI_TRANSCRIBER_WHISPER_PRIVATE_KEY_NAME=
JIGASI_XMPP_USER=jigasi
JIGASI_TRANSCRIBER_USER=transcriber
JIGASI_BREWERY_MUC=jigasibrewery
