{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet-service/contract/v1/webhook-occupant-joined.schema.json",
  "title": "POST {MEET_APP_API_URL}/events/occupant/joined",
  "type": "object",
  "required": [
    "event_name",
    "is_breakout",
    "room_jid",
    "room_name",
    "occupant",
    "active_occupants_count"
  ],
  "properties": {
    "event_name": {
      "const": "muc-occupant-joined"
    },
    "is_breakout": {
      "type": "boolean"
    },
    "room_jid": {
      "type": "string"
    },
    "room_name": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "breakout_room_id": {
      "type": "string",
      "description": "Breakout rooms only; room_jid and room_name then name the main room"
    },
    "breakout_meeting_id": {
      "type": "string"
    },
    "occupant": {
      "$ref": "occupant.schema.json"
    },
    "active_occupants_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
